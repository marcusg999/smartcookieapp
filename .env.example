# Smart Cookie: environment variables.
# Copy to .env.local for local development. Every variable is REQUIRED unless
# marked optional; `pnpm dev` and `pnpm build` fail if one is missing or malformed.
# The values below are dummies in the right format, never real keys.

# ── App ──────────────────────────────────────────────────────────────────────
# development | staging | production. Production requires Stripe *live* keys;
# every other environment requires Stripe *test* keys.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Local values come from `pnpm supabase status` after `pnpm supabase start`.
# Publishable key (formerly "anon key"): safe in the browser, RLS-restricted.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dummy_local_key
# Secret key (formerly "service_role key"): SERVER ONLY, bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_dummy_local_key

# ── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy

# ── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_dummy

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Cloudflare's documented always-pass test keys, fine for local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Upstash Redis (rate limiting) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=dummy_token

# ── Sentry ───────────────────────────────────────────────────────────────────
# The DSN is not a secret (it ships to the browser by design).
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.us.sentry.io/0
# Optional, build-time only: upload source maps.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ── Testing only (optional) ──────────────────────────────────────────────────
# Shortens the 5-minute MFA step-up window (1–300 s). Never set in production.
# STEP_UP_MAX_AGE_SECONDS=
